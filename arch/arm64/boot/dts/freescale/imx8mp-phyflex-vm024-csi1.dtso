#include <dt-bindings/media/video-interfaces.h>

/dts-v1/;
/plugin/;

#include "imx8mp-phycore-isi-csi1.dtsi"
#include "imx8mp-phycore-isp-csi1.dtsi"

&{/} {
	vm024_csi1_clk: vm024-csi1-ext-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <20000000>;
	};
};

&i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;

	camera@36 {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		compatible = "onnn,ar0830";
		reg = <0x36>;
		clocks = <&vm024_csi1_clk>;
		clock-names = "ext";
		orientation = <2>;
		rotation = <0>;

		port@0 {
			reg = <0>;

			vm024_csi1_ep: endpoint {
				remote-endpoint = <&mipi_csi0_ep>;
				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
				link-frequencies = /bits/ 64 <288000000 375000000 500000000 562500000 600000000 750000000>;
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
			};
		};
	};

	eeprom@56 {
		compatible = "atmel,24c02";
		reg = <0x56>;
		pagesize = <16>;
	};
};

&mipi_csi_0 {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;
		mipi_csi0_ep: endpoint {
			remote-endpoint = <&vm024_csi1_ep>;
			data-lanes = <4>;
			csis-hs-settle = <13>;
			csis-clk-settle = <2>;
			csis-wclk;
		};
	};
};
