/dts-v1/;
/plugin/;

&{/} {
	vm017_clk: vm017-ext-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <27000000>;
	};
};

&i2c4 {
	#address-cells = <1>;
	#size-cells = <0>;

	vm017: camera@36 {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		compatible = "onsemi,ar0521";
		reg = <0x36>;
		clocks = <&vm017_clk>;
		clock-names = "ext";

		port@0 {
			reg = <0>;

			vm017_ep: endpoint {
				remote-endpoint = <&mipi_csi_ep>;
				bus-type = <4>; /* MIPI CSI-2 D-PHY */
				link-frequencies = /bits/ 64 <504000000>;
				data-lanes = <1 2 3 4>;
				clock-lanes = <0>;
				clock-noncontinuous = <1>;
			};
		};
	};
};

&csi1 {
	status = "okay";
};

&csi1_mipi_csi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			mipi_csi_ep: endpoint {
				remote-endpoint = <&vm017_ep>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};
