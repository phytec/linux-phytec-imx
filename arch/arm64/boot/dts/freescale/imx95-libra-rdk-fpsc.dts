/dts-v1/;

#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/leds/leds-pca9532.h>

#include "imx95-phycore-fpsc.dtsi"

/ {
	model = "PHYTEC Libra i.MX95 RDK FPSC";
	compatible = "phytec,imx95-libra-rdk-fpsc",
		     "phytec,imx95-phycore-fpsc", "fsl,imx95";

	aliases {
		ethernet0 = &enetc_port0;
		ethernet2 = &enetc_port2;
	};

	chosen {
		stdout-path = &lpuart7;
	};

	backlight_lvds0: backlight0 {
		compatible = "pwm-backlight";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lvds0>;
		power-supply = <&reg_vdd_12v0>;
		status = "disabled";
	};

	fan0: pwm-fan {
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		/* copied from bindings example, need to be tested */
		cooling-levels = <0 102 170 230>;
		pwms = <&tpm4 2 4000000 PWM_POLARITY_INVERTED>;
	};

	panel0_lvds: panel-lvds0 {
		/* compatible panel in overlay */
		backlight = <&backlight_lvds0>;
		power-supply = <&reg_vdd_3v3>;
		status = "disabled";

		port {
			panel0_in: endpoint {
				remote-endpoint = <&lvds0_out>;
			};
		};
	};

	reg_can1_stby: regulator-can1-stby {
	       compatible = "regulator-fixed";
	       gpio = <&gpio_expander 10 GPIO_ACTIVE_LOW>;
	       regulator-max-microvolt = <1800000>;
	       regulator-min-microvolt = <1800000>;
	       regulator-name = "can1-stby";
	};

	reg_can2_stby: regulator-can2-stby {
		compatible = "regulator-fixed";
		gpio = <&gpio_expander 9 GPIO_ACTIVE_LOW>;
		regulator-max-microvolt = <1800000>;
		regulator-min-microvolt = <1800000>;
		regulator-name = "can2-stby";
	};

	reg_vdd_1v8: regulator-vdd-1v8 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-name = "VDD_1V8";
	};

	reg_vdd_3v3: regulator-vdd-3v3 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "VDD_3V3";
	};

	reg_vdd_5v0: regulator-vdd-5v0 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "VDD_5V0";
	};

	reg_vdd_12v0: regulator-12v0 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <12000000>;
		regulator-min-microvolt = <12000000>;
		regulator-name = "VDD_12V0";
	};
};

&enetc_port0 {
	phy-handle = <&ethphy0>;
	status = "okay";
};

&enetc_port2 {
	managed = "in-band-status";
	phy-mode = "10gbase-r";
	phy-handle = <&ethphy2>;
};

/* CAN FD */
&flexcan1 {
	xceiver-supply = <&reg_can1_stby>;
	status = "okay";
};

&flexcan2 {
	xceiver-supply = <&reg_can2_stby>;
	status = "okay";
};

/* SPI-NOR */
&flexspi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexspi>;
	status = "okay";

	spi_nor: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <80000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&ldb {
	#address-cells = <1>;
	#size-cells = <0>;
	/* Channel 0 used for onboard LVDS */
	channel@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;
		status = "okay";

		port@1 {
			reg = <1>;

			lvds0_out: endpoint {
				remote-endpoint = <&panel0_in>;
			};
		};
	};
};

&lpi2c1 {
	temperature-sensor@4f {
		compatible = "nxp,p3t1755";
		reg = <0x4f>;
		vs-supply = <&reg_vdd_1v8>;
	};
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	leds@62 {
		compatible = "nxp,pca9533";
		reg = <0x62>;

		led-1 {
			type = <PCA9532_TYPE_LED>;
		};

		led-2 {
			type = <PCA9532_TYPE_LED>;
		};

		led-3 {
			type = <PCA9532_TYPE_LED>;
		};
	};
};

&lpi2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	gpio_expander: gpio@20 {
		compatible = "ti,tca6416";
		#gpio-cells = <2>;
		gpio-controller;
		gpio-line-names = "CSI1_CTRL1", "CSI1_CTRL2", "CSI1_CTRL3",
				  "CSI1_CTRL4", "CSI2_CTRL1", "CSI2_CTRL2",
				  "CSI2_CTRL3", "CSI2_CTRL4", "CLK_EN_AV",
				  "nCAN2_EN", "nCAN1_EN", "PCIE1_nWAKE",
				  "PCIE2_nWAKE", "PCIE2_nALERT_3V3",
				  "UART1_BT_RS_SEL", "UART1_RS232_485_SEL";
		interrupt-parent = <&gpio2>;
		interrupts = <17 IRQ_TYPE_LEVEL_LOW>;
		reg = <0x20>;
		vcc-supply = <&reg_vdd_1v8>;

		uart1_bt_rs_sel: bt-rs-hog {
			gpio-hog;
			gpios = <14 0>;
			output-low;
			line-name = "UART1_BT_RS_SEL";
		};

		uart1_rs232_485_sel: rs232-485-hog {
			gpio-hog;
			gpios = <15 0>;
			output-high;
			line-name = "UART1_RS232_485_SEL";
		};
	};
};

&lpi2c5 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	eeprom@51 {
		compatible = "atmel,24c02";
		vcc-supply = <&reg_vdd_1v8>;
		reg = <0x51>;
		pagesize = <16>;
	};

};

/* Used for M33 debug */
&lpuart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpuart2>;
};

/* A-55 debug UART */
&lpuart7 {
	status = "okay";
};

/* RS232/RS485/BT */
&lpuart8 {
	uart-has-rtscts;
	status = "okay";
};

&netc_emdio { /* RGMII2 */

	ethphy0: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
		interrupt-parent = <&gpio2>;
		interrupts = <16 IRQ_TYPE_LEVEL_LOW>;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_1_50_NS>;
		ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
		enet-phy-lane-no-swap;
	};

	ethphy2: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";

		max-speed = <10000>; /* 10Gbit/s */
		reg = <0x8>;
		status = "disabled";
	};
};

&pcie0 {
	reset-gpio = <&gpio1 10 GPIO_ACTIVE_LOW>;
	vpcie-supply = <&reg_vdd_3v3>;
	status = "okay";
};

&pcie1 {
	reset-gpio = <&gpio1 14 GPIO_ACTIVE_LOW>;
	vpcie-supply = <&reg_vdd_3v3>;
	status = "okay";
};

&rv3028 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rtc>;
	interrupt-parent = <&gpio2>;
	interrupts = <18 IRQ_TYPE_LEVEL_LOW>;
	aux-voltage-chargeable = <1>;
	wakeup-source;
	trickle-resistor-ohms = <3000>;
};

&gpio2 {
	gpio-line-names = "", "", "", "", "",
			  "", "", "", "", "",
			  "", "", "", "", "",
			  "", "RGMII2_nINT", "GPIO4", "RTC_nINT", "",
			  "LVDS_BL_EN";
};

&scmi_iomuxc {
	pinctrl_lvds0: lvds0grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO20__GPIO2_IO_BIT20	0x31e
		>;
	};

	pinctrl_tpm4: tpm4grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO21__TPM4_CH1	0x31e
		>;
	};

	pinctrl_lpuart2: lpuart2grp { /* FPSC proprietary */
		fsl,pins = <
			IMX95_PAD_UART2_TXD__AONMIX_TOP_LPUART2_TX	0x31e
			IMX95_PAD_UART2_RXD__AONMIX_TOP_LPUART2_RX	0x31e
		>;
	};
	pinctrl_rtc: rtcgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO18__GPIO2_IO_BIT18	0x31e
		>;
	};
};

&thermal_zones {
	a55-thermal {
		trips {
			atrip2: trip2 {
				temperature = <55000>;
				hysteresis = <2000>;
				type = "active";
			};

			atrip3: trip3 {
				temperature = <65000>;
				hysteresis = <2000>;
				type = "active";
			};

			atrip4: trip4 {
				temperature = <75000>;
				hysteresis = <2000>;
				type = "active";
			};
		};

		cooling-maps {
			map1 {
				trip = <&atrip2>;
				cooling-device = <&fan0 0 1>;
			};

			map2 {
				trip = <&atrip3>;
				cooling-device = <&fan0 1 2>;
			};

			map3 {
				trip = <&atrip4>;
				cooling-device = <&fan0 2 3>;
			};
		};
	};
};

&tpm4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm4>;
	status = "okay";
};

/* USB Hub */
&usb2 {
        dr_mode = "host";
        status = "okay";
};

/* uSD Card */
&usdhc2 {
	status = "okay";
};
